  m_text: "\xB7Collect<sprite name=\"mykd_sm_jz\">to invest in the nation and win
    big!\n\xB7There are a total of 8 divisions from the East Coast to the West Coast.In
    each division, 3 states can be selected for investment.When all 3 states in the
    division are successfully invested in, it triggers a Gold Train Express.\n\xB7After
    all divisions have been invested in, a Super Dollar Express is triggered with<sprite
    name=\"mykd_sm_jz\">on reel 5."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5cc5a7a669949684bbf68b96181ad1b6, type: 2}
