syntax = "proto3";

import "room.proto";

//百家乐玩家信息
message BaccaratPlayerInfo {
  int64 playerId = 1;  //玩家ID
  string playerName = 2;  //玩家名
  string local = 3;  //玩家地址
  int32 vipLevel = 4;  //VIP等级
  int64 goldNum = 5;  //玩家当前金币
  int64 totalBet = 6;  //近20局下注金币总数
  int32 winCount = 7;  //近20局赢的总局数
}

//百家乐结算信息
message BaccaratSettleInfo {
  repeated uint32 bankerCardIds = 1;  //庄家牌ID信息
  uint32 extraBankerCardId = 2;  //庄家补牌ID
  uint32 bankerPointId = 3;  //庄家总点数
  repeated uint32 playerCardIds = 4;  //闲家牌ID信息
  uint32 extraPlayerCardId = 5;  //闲家补牌ID
  uint32 playerPointId = 6;  //闲家总点数
  uint32 winState = 7;  //输赢状态, 1：庄赢，2：闲赢，3：和
  uint32 cardTypeWinState = 8;  //牌型的输赢状态, 0：默认状态，1：庄对，2：闲对，3：庄和闲都有对子
  int64 playerGoldChange = 9;  //玩家金币变化值
}

//百家乐下注区域信息
message BaccaratTableAreaInfo {
  int32 areaId = 1;  //区域ID
  int64 playerBetGold = 2;  //玩家已下注金币
  int64 areaTotalBetGold = 3;  //区域总下注金币
}

//百家乐房间摘要
message BaccaratTableSummary {
  int64 roomId = 1;  //房间ID,房间唯一ID
  int32 wareId = 2;  //场次ID
  int32 restCardNum = 3;  //剩余牌数量
  int32 totalCardNum = 4;  //总的牌数量
  EGamePhase eGamePhase = 5;  //游戏阶段信息
  int32 phaseTotalTime = 6;  //阶段总时间
  int64 phaseEndTime = 7;  //阶段结束时间戳
  repeated uint32 winStateList = 8;  //输赢状态, 1：庄赢，2：闲赢，3：和
  repeated uint32 cardTypeWinStateList = 9;  //牌型的输赢状态, 0：默认状态，1：庄对，2：闲对，3：庄和闲都有对子
}

//请求,msgID=0x5082,desc=
message NotifyRoomReadyWait {
  enum E_MsgID {def = 0; msgID = 20610;};
  int64 roomId = 1;  //房间ID
  int64 waitEndTime = 2;  //等待时间结束的时间戳
}

//请求,msgID=0x18001,desc=请求获取百家乐房间摘要信息
message ReqBaccaratTableSummary {
  enum E_MsgID {def = 0; msgID = 98305;};
  int64 roomId = 1;  //房间ID
}

//请求,msgID=0x18001,desc=请求获取百家乐房间摘要信息
message ReqBaccaratTableSummaryList {
  enum E_MsgID {def = 0; msgID = 983051;};
}

//请求,msgID=0x18081,desc=通知百家乐桌上信息
message NotifyBaccaratTableInfo {
  enum E_MsgID {def = 0; msgID = 98433;};
  EGamePhase gamePhase = 1;  //场上阶段信息
  int64 tableCountDownTime = 2;  //场上倒计时结束时间戳
  BaccaratSettleInfo baccaratSettleInfo = 3;  //场上结算信息，如果场上阶段不为结算，此值为空
  repeated BaccaratTableAreaInfo tableAreaInfos = 4;  //区域下注信息
  repeated BaccaratPlayerInfo playerInfos = 5;  //玩家当前信息
}

//请求,msgID=0x18082,desc=返回房间摘要信息
message RespBaccaratTableSummaryList {
  enum E_MsgID {def = 0; msgID = 98434;};
  repeated BaccaratTableSummary tableSummaryList = 1;  //房间摘要列表
}

//请求,msgID=0x18083,desc=返回房间单条摘要信息
message RespBaccaratTableSummary {
  enum E_MsgID {def = 0; msgID = 98435;};
  BaccaratTableSummary tableSummary = 1;  //房间单条摘要信息
  int32 code = 2;  //状态码 状态码:200-消息正常 异常状态码202-房间已销毁
}

//请求,msgID=0x20001,desc=请求下注
message ReqBet {
  enum E_MsgID {def = 0; msgID = 131073;};
  int32 betValue = 1;  //请求下注的金额
  int32 betAreaIdx = 2;  //下注区域，1: 闲对 2: 和 3: 庄对 4: 闲 5: 庄
}

//请求,msgID=0x20081,desc=请求下注返回
message RespBet {
  enum E_MsgID {def = 0; msgID = 131201;};
  int32 bet = 1;  //下注倍数
  int64 playerId = 2;  //玩家ID
  int32 betArea = 3;  //下注区域
}

