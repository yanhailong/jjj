syntax = "proto3";//阶段信息
enum EGamePhase {
  BET = 0;  //下注
  PLAY_CART = 1;  //出牌
  DISS_MISS = 2;  //解散房间
  WAIT_READY = 3;  //等待开始
  GAME_ROUND_OVER_SETTLEMENT = 4;  //游戏一个回合结束进行结算
}

//响应,msgID=0x5081
message RespPlayerExitRoom {
  enum E_MsgID {def = 0; msgID = 20609;};
  int32 code = 1;  //错误码
  int64 playerId = 2;  //玩家ID
}

