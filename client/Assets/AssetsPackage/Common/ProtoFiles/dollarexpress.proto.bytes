syntax = "proto3";//请求,msgID=0x7099,desc=开始游戏结果返回
message NoticeConfigInfo {
  enum E_MsgID {def = 0; msgID = 28825;};
  repeated int32 stakeList = 1;
}

//请求,msgID=0x7005,desc=请求开始游戏
message ReqStartGame {
  enum E_MsgID {def = 0; msgID = 28677;};
  int64 stakeVlue = 1;  //下注金额
}

//响应,msgID=0x7006,desc=开始游戏结果返回
message ResStartGame {
  enum E_MsgID {def = 0; msgID = 28678;};
  int32 code = 1;  //状态码
  repeated int32 iconList = 2;  //图标id列表
  repeated ResultLineInfo resultLineInfoList = 3;  //中奖信息
  int64 allWinGold = 4;  //累计中奖金币
  int32 specialId = 5;  //特殊游戏id
}

//每条中奖线信息
message ResultLineInfo {
  int32 id = 1;  //中奖线id
  repeated int32 indexList = 2;  //这条线上中奖图标的坐标
  int32 times = 3;  //倍率
  int64 winGold = 4;  //中奖金币
}

