syntax = "proto3";//每个场次配置信息
message WareHouseConfigInfo {
  int32 wareId = 1;  //场次id
  string name = 2;  //场次名称
  int64 pool = 3;  //奖池
  int32 limitVipMin = 4;  //进入vip最低等级
  int64 limitGoldMin = 5;  //进入最低金币数量
}

//请求,msgID=0x6003,desc=请求进入游戏
message ReqChooseGame {
  enum E_MsgID {def = 0; msgID = 24579;};
  int32 gameType = 1;  //游戏类型
}

//请求,msgID=0x6005,desc=选择游戏场次进入
message ReqChooseWare {
  enum E_MsgID {def = 0; msgID = 24581;};
  int32 gameType = 1;  //游戏类型
  int32 wareId = 2;  //场次id
}

//请求,msgID=0x3001,desc=登录请求
message ReqLogin {
  enum E_MsgID {def = 0; msgID = 12289;};
  int64 playerId = 1;  //玩家id
  string token = 2;  //验证token
}

//响应,msgID=0x6004,desc=进入游戏返回
message ResChooseGame {
  enum E_MsgID {def = 0; msgID = 24580;};
  int32 code = 1;  //状态码
  repeated WareHouseConfigInfo wareHouseList = 2;  //场次列表
}

//响应,msgID=0x6006,desc=选择游戏场次进入
message ResChooseWare {
  enum E_MsgID {def = 0; msgID = 24582;};
  int32 code = 1;  //状态码
}

//响应,msgID=0x3002,desc=登录返回
message ResLogin {
  enum E_MsgID {def = 0; msgID = 12290;};
  int32 code = 1;  //状态码
  int64 playerId = 2;  //玩家id
  string nickName = 3;  //昵称
  int64 gold = 4;  //金币
  int64 diamond = 5;  //钻石
  int32 vipLevel = 6;  //vip等级
  repeated GameListConfig gameList = 7;  //游戏列表
}

message GameListConfig {
  int32 sid = 1;  //配置id
  string name = 2;
  int32 status = 3;  //状态  0.开启  1.维护  2.关闭
}

