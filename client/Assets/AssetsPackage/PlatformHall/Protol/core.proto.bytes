syntax = "proto3";//网络状态枚举
enum NetStatEnum {
  NETWORK_CANT_USE = 0;  //网络不可用
  NETWORK_SUCCESS = 1;  //连接成功
  SERVICE_CANT_USE = 2;  //服务不可用
  PLAYER_KICKOUT = 3;  //踢出下线
}

//响应,msgID=0x1003,desc=通知网络状态
message NoticeServerStatus {
  enum E_MsgID {def = 0; msgID = 4099;};
  NetStatEnum result = 1;
}

//请求,msgID=0x1001,desc=心跳请求
message ReqHeartBeat {
  enum E_MsgID {def = 0; msgID = 4097;};
  bool none = 1;
}

//响应,msgID=0x1002,desc=心跳返回
message ResHeartBeat {
  enum E_MsgID {def = 0; msgID = 4098;};
  int64 time = 1;
}

message Pack {
  int32 cmd = 1;
  bytes data = 2;
}

//响应,msgID=0x4099,desc=推送金钱变化
message NoticeMoneyChange {
  enum E_MsgID {def = 0; msgID = 16537;};
  int64 gold = 1;  //金币
  int64 diamond = 2;  //钻石
}

//请求,msgID=0x4001,desc=gm请求
message ReqGm {
  enum E_MsgID {def = 0; msgID = 16385;};
  string order = 1;  //命令参数
}

//响应,msgID=0x4002,desc=gm返回
message ResGm {
  enum E_MsgID {def = 0; msgID = 16386;};
  int32 code = 1;  //状态码
  string result = 2;
}

