syntax = "proto3";import "room.proto";//飞禽走兽历史记录bean
message AnimalsHistoryBean {
  int32 betIdxId = 1;  //下注ID
  int32 animalId = 2;  //动物ID 1-鹦鹉 2-鸽子 5-老虎 6-耗牛 7-火烈鸟 8-老鹰 9-金鲨 10-银鲨 11-狮子 12-熊 13-通杀 14-通赔
}

//结算信息
message AnimalsSettlementInfo {
  int32 rewardAreaIdx = 1;  //中奖区域ID
  repeated BetTableInfo betTableInfos = 2;  //玩家场上押注数据
  int64 tableCountDownTime = 3;  //场上倒计时结束时间戳
  repeated PlayerChangedGold playerChangedGolds = 4;  //玩家金币变化列表
  repeated int32 animalsId = 5;  //动物ID列表
}

//百家乐基础信息
message BaccaratBaseInfo {
  int64 roomId = 1;  //房间ID,房间唯一ID
  int32 wareId = 2;  //场次ID
  int32 remainingCardNum = 3;  //剩余牌数量
  int32 totalCardNum = 4;  //总的牌数量
  EGamePhase eGamePhase = 5;  //游戏阶段信息
  int32 phaseTotalTime = 6;  //阶段总时间
  int64 phaseEndTimestamp = 7;  //阶段结束时间戳
  int64 serverCurrentTime = 8;  //服务器当前时间
}

//百家乐牌型状态
message BaccaratCardState {
  uint32 winState = 1;  //输赢状态, 1：庄赢，2：闲赢，3：和
  uint32 cardTypeWinState = 2;  //牌型的输赢状态, 0：默认状态，1：庄对，2：闲对，3：庄和闲都有对子
  bool hasKingCard = 3;  //是否是天王牌
}

//百家乐结算信息
message BaccaratSettlementInfo {
  repeated uint32 bankerCardIds = 1;  //庄家牌ID信息
  uint32 extraBankerCardId = 2;  //庄家补牌ID
  uint32 bankerPointId = 3;  //庄家总点数
  repeated uint32 playerCardIds = 4;  //闲家牌ID信息
  uint32 extraPlayerCardId = 5;  //闲家补牌ID
  uint32 playerPointId = 6;  //闲家总点数
  BaccaratCardState cardState = 7;  //牌型状态
}

//百家乐桌上信息
message BaccaratTableInfo {
  repeated TablePlayerInfo tablePlayerInfoList = 1;  //房间的玩家信息
  int64 tableCountDownTime = 2;  //场上倒计时结束时间戳
  int32 totalTime = 3;  //场上总时间
  repeated BetTableInfo tableAreaInfos = 4;  //区域下注信息
}

//百家乐房间摘要
message BaccaratTableSingleRes {
  BaccaratBaseInfo baccaratBaseInfo = 1;  //百家乐游戏基础信息
  BaccaratCardState baccaratCardState = 2;  //百家乐牌状态
  int32 roundId = 3;  //对局ID
  bool needClearRoad = 4;  //是否需要清除路单, 在结算阶段告知下一回合服务器是否会重新洗牌
}

//百家乐房间摘要
message BaccaratTableSummary {
  int64 roomId = 1;  //roomId
  BaccaratBaseInfo baccaratBaseInfo = 2;  //百家乐游戏基础信息
  repeated BaccaratCardState cardStateList = 3;  //牌型输赢状态
}

//押注信息
message BetTableInfo {
  int32 betIdx = 1;  //下标
  int64 playerBetTotal = 2;  //玩家总押注
  int64 betIdxTotal = 3;  //区域下标的总的押注数量
  int64 betValue = 4;  //玩家此次下注的金币数量
  repeated int32 betGoldList = 5;  //区域押注金币列表
}

//玩家金币更新
message PlayerChangedGold {
  int64 playerId = 1;  //玩家ID
  int64 playerWinGold = 2;  //玩家场上赢的金币
  int64 playerBetGold = 3;  //玩家场上下注金币
}

//请求押注的bean
message ReqBetBean {
  int64 betValue = 1;  //请求下注的金额
  int32 betAreaIdx = 2;  //下注区域，1: 庄对 2: 和 3: 闲对 4: 闲 5: 庄
}

//牌桌玩家信息
message TablePlayerInfo {
  int64 playerId = 1;  //玩家ID
  string playerName = 2;  //玩家名
  string local = 3;  //玩家地址
  int32 vipLevel = 4;  //VIP等级
  int64 goldNum = 5;  //玩家当前金币
  int64 totalBet = 6;  //近20局下注金币总数
  int32 winCount = 7;  //近20局赢的总局数
}

//结算信息
message LuxuryCarClubSettlementInfo {
  int32 rewardAreaIdx = 1;  //中奖区域ID
  repeated BetTableInfo betTableInfos = 2;  //玩家场上押注数据
  int64 tableCountDownTime = 3;  //场上倒计时结束时间戳
  repeated PlayerChangedGold playerChangedGolds = 4;  //玩家金币变化列表
}

//红黑大战历史记录
message RedBlackWarHistory {
  int32 winner = 1;  //获胜方(1红 2黑)
  int32 cardType = 2;  //牌型 
}

//响应,msgID=0x5082,desc=通知房间进入
message NotifyRoomReadyWait {
  enum E_MsgID {def = 0; msgID = 20610;};
  int32 code = 1;  //状态码
  int64 roomId = 2;  //房间ID
  int64 waitEndTime = 3;  //等待时间结束的时间戳
}

//响应,msgID=0x13003,desc=红黑大战结算信息
message NotifyRedBlackWarSettleInfo {
  enum E_MsgID {def = 0; msgID = 77827;};
  int32 code = 1;  //状态码
  repeated int32 redCards = 2;  //红方牌
  int32 redCardType = 3;  //红方牌型
  repeated int32 blackCards = 4;  //黑方牌
  int32 blackCardType = 5;  //黑方牌型
  int32 winState = 6;  //获胜状态(1红方胜 2黑方胜)
  repeated TablePlayerInfo playerInfos = 7;  //前6玩家信息
  repeated PlayerChangedGold playerSettleInfos = 8;  //玩家结算信息
}

//响应,msgID=0x13081,desc=通知红黑大战桌上信息
message NotifyRedBlackWarInfo {
  enum E_MsgID {def = 0; msgID = 77953;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //场上阶段信息
  int64 tableCountDownTime = 3;  //场上倒计时结束时间戳
  repeated BetTableInfo tableAreaInfos = 4;  //区域下注信息
  repeated RedBlackWarHistory redBlackHistories = 5;  //当前房间的历史记录
  NotifyRedBlackWarSettleInfo settleInfos = 6;  //结算信息
  repeated int32 betPointList = 7;  //押分列表
  repeated TablePlayerInfo playerInfos = 8;  //前6玩家信息
  int32 totalPlayerNum = 9;  //房间总人数
}

//响应,msgID=0x14001,desc=通知龙虎斗桌上信息
message NotifyLoongTigerWarInfo {
  enum E_MsgID {def = 0; msgID = 81921;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //场上阶段信息
  int64 tableCountDownTime = 3;  //场上倒计时结束时间戳
  repeated BetTableInfo tableAreaInfos = 4;  //区域下注信息
  repeated int32 histories = 5;  //当前房间的历史记录
  NotifyLoongTigerWarSettleInfo settleInfos = 6;  //结算信息
  repeated int32 betPointList = 7;  //押分列表
  repeated TablePlayerInfo playerInfos = 8;  //前6玩家信息
  int32 totalPlayerNum = 9;  //房间总人数
}

//响应,msgID=0x14002,desc=龙虎斗结算信息
message NotifyLoongTigerWarSettleInfo {
  enum E_MsgID {def = 0; msgID = 81922;};
  int32 code = 1;  //状态码
  int32 loongCard = 2;  //龙方牌
  int32 tigerCard = 3;  //虎方牌
  int32 winState = 4;  //获胜状态(1龙胜 2虎胜 3和)
  repeated TablePlayerInfo playerInfos = 5;  //前6玩家信息
  repeated PlayerChangedGold playerSettleInfos = 6;  //玩家结算信息
}

//响应,msgID=0x16081,desc=飞禽走兽桌面信息，下注，结算，断线重连
message NotifyAnimalsTableInfo {
  enum E_MsgID {def = 0; msgID = 90241;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //场上阶段信息
  int64 tableCountDownTime = 3;  //场上倒计时结束时间戳
  repeated BetTableInfo tableAreaInfos = 4;  //区域下注信息
  repeated int32 betPointList = 5;  //押分分值列表
  TablePlayerInfo playerInfo = 6;  //当前玩家信息
  int32 totalPlayerNum = 7;  //房间总人数
  repeated AnimalsHistoryBean settlementHistory = 8;  //结算历史，首次进入时发送，下注区域id列表
  AnimalsSettlementInfo settlementInfo = 9;  //结算信息，当阶段为结算时发送
}

//响应,msgID=0x16082,desc=通知飞禽走兽结算信息
message NotifyAnimalsSettlement {
  enum E_MsgID {def = 0; msgID = 90242;};
  int32 code = 1;  //状态码
  AnimalsSettlementInfo settlementInfo = 2;  //结算信息
}

//响应,msgID=0x17081,desc=豪车俱乐部桌面信息，下注，结算，断线重连
message NotifyLuxuryCarClubTableInfo {
  enum E_MsgID {def = 0; msgID = 94337;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //场上阶段信息
  int64 tableCountDownTime = 3;  //场上倒计时结束时间戳
  repeated BetTableInfo tableAreaInfos = 4;  //区域下注信息
  repeated int32 betPointList = 5;  //押分分值列表
  TablePlayerInfo playerInfo = 6;  //当前玩家信息
  int32 totalPlayerNum = 7;  //房间总人数
  repeated int32 settlementHistory = 8;  //结算历史，首次进入时发送，下注区域id列表
  LuxuryCarClubSettlementInfo settlementInfo = 9;  //结算信息，当阶段为结算时发送
}

//响应,msgID=0x17082,desc=通知豪车俱乐部结算信息
message NotifyLuxuryCarClubSettlement {
  enum E_MsgID {def = 0; msgID = 94338;};
  int32 code = 1;  //状态码
  LuxuryCarClubSettlementInfo settlementInfo = 2;  //结算信息
}

//请求,msgID=0x18001,desc=请求获取百家乐房间摘要信息
message ReqBaccaratTableSummaryList {
  enum E_MsgID {def = 0; msgID = 98305;};
  int32 wareId = 1;  //游戏场次
}

//请求,msgID=0x18002,desc=请求获取百家乐房间摘要信息
message ReqBaccaratTableSummary {
  enum E_MsgID {def = 0; msgID = 98306;};
  int64 roomId = 1;  //房间ID
  int32 roundId = 2;  //对局ID
}

//请求,msgID=0x18004
message ReqBaccaratTableInfo {
  enum E_MsgID {def = 0; msgID = 98308;};
}

//请求,msgID=0x18005,desc=在游戏中请求加入房间
message ReqJoinRoomInGame {
  enum E_MsgID {def = 0; msgID = 98309;};
  int64 roomId = 1;  //房间ID
  int32 gameType = 2;  //游戏类型
  int32 wareId = 3;  //场次id
}

//请求,msgID=0x18006,desc=在游戏中请求退出房间
message ReqExitRoomInGame {
  enum E_MsgID {def = 0; msgID = 98310;};
}

//响应,msgID=0x18081,desc=断线重连 通知玩家百家乐牌桌信息
message NotifyBaccaratTableInfo {
  enum E_MsgID {def = 0; msgID = 98433;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //场上阶段信息
  repeated BaccaratCardState cardStateList = 3;  //玩家第一次进入时初始化路单信息
  BaccaratTableInfo baccaratTableInfo = 4;  //桌面的数据
  repeated PlayerChangedGold playerChangedGolds = 5;  //结算时玩家赢的金币值
  BaccaratSettlementInfo baccaratSettlementInfo = 6;  //场上结算信息，如果场上阶段不为结算，此值为空
}

//响应,msgID=0x18082,desc=返回房间摘要信息
message RespBaccaratTableSummaryList {
  enum E_MsgID {def = 0; msgID = 98434;};
  int32 code = 1;  //状态码
  repeated BaccaratTableSummary tableSummaryList = 2;  //房间摘要列表
}

//响应,msgID=0x18083,desc=返回房间单条摘要信息
message NotifyBaccaratTableSummary {
  enum E_MsgID {def = 0; msgID = 98435;};
  int32 code = 1;  //状态码
  BaccaratTableSingleRes tableSummary = 2;  //房间单条摘要信息
}

//响应,msgID=0x18084,desc=返回百家乐桌上信息 首次进入
message RespBaccaratTableInfo {
  enum E_MsgID {def = 0; msgID = 98436;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //场上阶段信息
  repeated BaccaratCardState cardStateList = 3;  //玩家第一次进入时初始化路单信息
  BaccaratTableInfo baccaratTableInfo = 4;  //桌面的数据
  repeated PlayerChangedGold playerChangedGolds = 5;  //结算时玩家赢的金币值
  BaccaratSettlementInfo baccaratSettlementInfo = 6;  //场上结算信息，如果场上阶段不为结算，此值为空
  repeated int32 betInfoList = 7;  //压分列表
  int32 playerTotalNum = 8;  //玩家总人数
}

//响应,msgID=0x18085,desc=百家乐通知下注开始
message NotifyBaccaratBetStart {
  enum E_MsgID {def = 0; msgID = 98437;};
  int32 code = 1;  //状态码
  BaccaratTableInfo baccaratTableInfo = 2;  //桌面的数据
}

//响应,msgID=0x18086,desc=百家乐结算信息
message NotifyBaccaratSettlementInfo {
  enum E_MsgID {def = 0; msgID = 98438;};
  int32 code = 1;  //状态码
  BaccaratTableInfo baccaratTableInfo = 2;  //桌面的数据
  BaccaratSettlementInfo baccaratSettlementInfo = 3;  //场上结算信息，如果场上阶段不为结算，此值为空
  repeated PlayerChangedGold playerChangedGolds = 4;  //结算时玩家赢的金币值
  bool needClearRoad = 5;  //是否需要清除路单, 在结算阶段告知下一回合服务器是否会重新洗牌
}

//响应,msgID=0x18087,desc=在游戏中返回加入房间
message RespJoinRoomInGame {
  enum E_MsgID {def = 0; msgID = 98439;};
  int32 code = 1;  //状态码
  int32 roomCfgId = 2;  //房间配置ID
}

//响应,msgID=0x18088,desc=在游戏中返回退出房间
message RespExitRoomInGame {
  enum E_MsgID {def = 0; msgID = 98440;};
  int32 code = 1;  //状态码
}

//请求,msgID=0x20001,desc=请求下注
message ReqBet {
  enum E_MsgID {def = 0; msgID = 131073;};
  repeated ReqBetBean reqBetBeans = 1;  //请求押注和续押
}

//请求,msgID=0x20003,desc=请求获取百人牌桌的玩家信息
message ReqTablePlayerInfo {
  enum E_MsgID {def = 0; msgID = 131075;};
}

//请求,msgID=0x20004
message ReqRoomBaseInfo {
  enum E_MsgID {def = 0; msgID = 131076;};
}

//响应,msgID=0x20081,desc=请求下注返回
message NotifyPlayerBet {
  enum E_MsgID {def = 0; msgID = 131201;};
  int32 code = 1;  //状态码
  int64 playerId = 2;  //玩家ID
  int64 playerCurGold = 3;  //下注玩家当前金币
  repeated BetTableInfo betTableInfoList = 4;  //玩家押注信息列表
}

//响应,msgID=0x20083,desc=返回牌桌玩家列表的下注信息
message RespTablePlayerInfo {
  enum E_MsgID {def = 0; msgID = 131203;};
  int32 code = 1;  //状态码
  repeated TablePlayerInfo tablePlayerInfo = 2;  //牌桌的玩家信息
}

//响应,msgID=0x20088,desc=通知押注类房间玩家信息变化
message NotifyTableRoomPlayerInfoChange {
  enum E_MsgID {def = 0; msgID = 131208;};
  int32 code = 1;  //状态码
  int64 changedPlayerId = 2;  //产生变化的玩家ID
  int32 totalPlayerNum = 3;  //总人数
  repeated TablePlayerInfo tableChangedPlayerInfos = 4;  //变化后的场上玩家信息
}

//响应,msgID=0x20089
message NotifyPhaseChangInfo {
  enum E_MsgID {def = 0; msgID = 131209;};
  int32 code = 1;  //状态码
  EGamePhase gamePhase = 2;  //当前阶段
  int64 endTime = 3;  //结束时间戳
}

